# Porta em que a API sobe localmente.
PORT=3333

# String de conexão do MongoDB. Suba o banco com "docker compose up -d" na raiz do
# projeto antes de iniciar a API — o valor abaixo já aponta para esse container local.
MONGODB_URI=mongodb://localhost:27017/whatsbot

# Token que você mesmo escolhe e cadastra no painel da Meta ao configurar o webhook
# (Meta > seu app > WhatsApp > Configuration > Webhook > Verify token).
META_VERIFY_TOKEN=dev-verify-token

# Credenciais da Meta Cloud API (developers.facebook.com/docs/whatsapp/cloud-api).
# Preencher aqui é OPCIONAL: você também pode colar essas credenciais direto no painel,
# em Configurações > Conectar WhatsApp, sem precisar reiniciar a API. Nunca cole valores
# reais neste arquivo (.env.example é o template versionado) — use um arquivo .env local,
# que já está no .gitignore.
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
